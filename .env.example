# -----------------------------------------------------------------------------
# Entorno de la aplicación
# -----------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Seguridad — OBLIGATORIAS para producción y desarrollo
# -----------------------------------------------------------------------------
# Genera un secret seguro de al menos 32 caracteres, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""

# -----------------------------------------------------------------------------
# Base de datos MySQL (Hostinger Business) — OBLIGATORIAS
# -----------------------------------------------------------------------------
# Datos que entrega hPanel al crear la base de datos MySQL.
DB_HOST="localhost"
DB_PORT=3306
DB_USER=""
DB_PASSWORD=""
DB_NAME=""

# -----------------------------------------------------------------------------
# Usuario administrador inicial (solo lo usa `npm run db:seed`)
# -----------------------------------------------------------------------------
# NO se hardcodea ningún admin en el código. El seed crea este usuario.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NOMBRE="Administrador"
ADMIN_APELLIDO="Jaguar"

# -----------------------------------------------------------------------------
# Pasarela de pagos Mercado Pago (Checkout Pro — variante Preferences API)
# -----------------------------------------------------------------------------
# Panel: https://www.mercadopago.com.co/developers/panel/app → tu aplicación.
# MP_ACCESS_TOKEN: "Credenciales de prueba" o "Credenciales de producción" → Access Token.
#   OJO: en Checkout Pro el de PRUEBA también empieza con APP_USR- — no se distingue por
#   el prefijo, así que cada ambiente (.env local / Hostinger) debe tener el suyo.
# MP_WEBHOOK_SECRET: "Webhooks → Configurar notificaciones" → clave secreta (NO es el
#   Access Token). URL del webhook: https://TU_DOMINIO/api/ordenes/mp-webhook, evento "Pagos".
# Ninguna de las dos llega al frontend (no hay variable VITE_ para pagos).
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
# Opcionales (sin definir = comportamiento por defecto de Mercado Pago):
# MP_STATEMENT_DESCRIPTOR="JAGUARCOFFEE"   # texto en el extracto de la tarjeta, máx. 13
# MP_EXCLUDED_PAYMENT_TYPES="ticket"       # excluir tipos de pago (ticket=Efecty, bank_transfer=PSE)
# MP_MAX_INSTALLMENTS="12"                 # tope de cuotas con tarjeta de crédito (1-36)
# MP_PREFERENCE_EXPIRATION_MINUTES="1440"  # vigencia del link de pago

# -----------------------------------------------------------------------------
# SMTP — envío de correos (recuperación de contraseña)
# -----------------------------------------------------------------------------
# Obligatorias en producción. En dev/test, si se dejan vacías, el correo se
# imprime en la consola del servidor en vez de enviarse (no hace falta cuenta real).
# Con Hostinger Business: hPanel → Correos → crea una cuenta (ej. noreply@tudominio.com)
# y usa esos datos SMTP (host suele ser mail.tudominio.com o smtp.hostinger.com, puerto 587).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Jaguar Coffee <noreply@tudominio.com>"
