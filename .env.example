# -----------------------------------------------------------------------------
# Entorno de la aplicación
# -----------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Seguridad — OBLIGATORIAS para producción y desarrollo
# -----------------------------------------------------------------------------
# Genera un secret seguro de al menos 32 caracteres, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""

# -----------------------------------------------------------------------------
# Base de datos MySQL (Hostinger Business) — OBLIGATORIAS
# -----------------------------------------------------------------------------
# Datos que entrega hPanel al crear la base de datos MySQL.
DB_HOST="localhost"
DB_PORT=3306
DB_USER=""
DB_PASSWORD=""
DB_NAME=""

# -----------------------------------------------------------------------------
# Usuario administrador inicial (solo lo usa `npm run db:seed`)
# -----------------------------------------------------------------------------
# NO se hardcodea ningún admin en el código. El seed crea este usuario.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NOMBRE="Administrador"
ADMIN_APELLIDO="Jaguar"

# -----------------------------------------------------------------------------
# Pasarela de pagos Wompi (Sandbox o Producción)
# -----------------------------------------------------------------------------
# Sandbox keys: https://docs.wompi.co/docs/en-us/sandbox
WOMPI_INTEGRITY_KEY=""
VITE_WOMPI_PUBLIC_KEY=""
